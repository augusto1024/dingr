{
  "name": "@augusto1024/dingr",
  "version": "1.0.0",
  "description": "A JavaScript and TypeScript sound effects library: synthesize deterministic audio, compose note sequences, and export WAV files without samples or runtime dependencies.",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://augusto1024.github.io/dingr/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/augusto1024/dingr.git"
  },
  "bugs": {
    "url": "https://github.com/augusto1024/dingr/issues"
  },
  "keywords": [
    "javascript",
    "typescript",
    "audio",
    "sound-effects",
    "synthesizer",
    "procedural-audio",
    "wav",
    "pcm"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "license": "Unlicense",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dingr": "./bin/dingr.mjs"
  }
}
