{
  "name": "dingr",
  "version": "0.5.0",
  "description": "Deterministic sound recipes, musical sequences, and portable WAV rendering.",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --config vitest.config.ts",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^1.6.1"
  },
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dingr": "./bin/dingr.mjs"
  }
}
